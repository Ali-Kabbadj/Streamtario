{
  "folders": [
    {
      "name": "addon-controller-service",
      "path": "apps/addon-controller-service"
    },
    {
      "name": "python-libs",
      "path": "packages/python"
    },
    { "name": "typescript-lib", "path": "packages/typescript" },
    { "name": "frontend", "path": "apps/frontend" },
    { "name": "state-tracker-service", "path": "apps/state-tracker-service" },
    {
      "name": "account-profile-service",
      "path": "apps/account-profile-service"
    },
    { "name": "webview2-host", "path": "apps/webview2-host" },
    { "name": "build", "path": "build" },
    { "name": "local_dev_deps", "path": "local_dev_deps" },
    { "name": "database", "path": "database" },
    { "name": "dev resources", "path": "dev_resources" },
    { "name": "api-gateway", "path": "apps/api-gateway" },
    { "name": "auth-service", "path": "apps/auth-service" }
  ],
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "tsc: build",
        "type": "shell",
        "command": "npm",
        "args": ["run", "build"],
        "options": { "cwd": "${workspaceFolder:api-gateway}" },
        "group": "build",
        "problemMatcher": ["$tsc"],
        "presentation": {
          "reveal": "always",
          "panel": "shared",
          "echo": true
        }
      },
      {
        "label": "Install Streamtario Python lib",
        "type": "shell",
        "command": "${command:python.interpreterPath}",
        "args": [
          "-m",
          "pip",
          "install",
          "-e",
          "../../packages/python",
          "-r",
          "../../requirements.txt"
        ],
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "presentation": {
          "echo": false,
          "reveal": "never",
          "focus": false,
          "panel": "shared",
          "clear": true,
          "close": true
        },
        "problemMatcher": []
      },
      {
        "label": "RUN FRONTEND",
        "type": "shell",
        "command": "npm run dev",
        "options": { "cwd": "${workspaceFolder:frontend}" },
        "isBackground": true,
        "problemMatcher": {
          "pattern": {
            "regexp": ".*Ready in.*",
            "file": 1,
            "location": 2,
            "message": 3
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".*Next.js.*",
            "endsPattern": ".*Ready in.*"
          }
        }
      },
      {
        "label": "CMake: Configure & Build",
        "type": "shell",
        "command": "cmake -S ${workspaceFolder:webview2-host} -B ${workspaceFolder:webview2-host}/build -DCMAKE_BUILD_TYPE=Debug -DCMAKE_TOOLCHAIN_FILE=${workspaceFolder:webview2-host}/vcpkg/scripts/buildsystems/vcpkg.cmake -DCMAKE_EXPORT_COMPILE_COMMANDS=ON && cmake --build ${workspaceFolder:webview2-host}/build --config Debug",
        "group": { "kind": "build", "isDefault": true },
        "problemMatcher": ["$msCompile"]
      },
      {
        "label": "FRONTEND and webview prepare",
        "dependsOrder": "sequence",
        "dependsOn": ["CMake: Configure & Build", "RUN FRONTEND"]
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "inputs": [
      {
        "id": "migrationMessage",
        "type": "promptString",
        "description": "Enter the message for the new migration",
        "default": "New migration"
      }
    ],
    "configurations": [
      {
        "name": "📅 Create Database",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:build}/scripts/db_cli.py",
        "args": ["create"],
        "console": "integratedTerminal",
        "presentation": { "hidden": false, "group": "db", "order": 1 }
      },
      {
        "name": "📅 Apply Migrations",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:build}/scripts/db_cli.py",
        "args": ["upgrade", "head"],
        "console": "integratedTerminal",
        "presentation": { "hidden": false, "group": "db", "order": 1 }
      },
      {
        "name": "📅 Generate New Migration",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:build}/scripts/db_cli.py",
        "args": ["generate", "-m", "${input:migrationMessage}"],
        "console": "integratedTerminal",
        "presentation": { "hidden": false, "group": "db", "order": 2 }
      },
      {
        "name": "⚠️ Drop Database",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:build}/scripts/db_cli.py",
        "args": ["drop"],
        "console": "integratedTerminal",
        "presentation": { "hidden": false, "group": "db", "order": 3 }
      },
      // --- SERVICE CONFIGURATIONS (UNCHANGED) ---
      {
        "name": "➕ Addons Service",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:build}/scripts/debug_runner.py",
        "args": ["app.settings:settings"],
        "cwd": "${workspaceFolder:addon-controller-service}",
        "justMyCode": false,
        "console": "internalConsole",
        "subProcess": false,
        "presentation": { "hidden": false, "group": "services", "order": 3 }
      },
      {
        "name": "➕ Auth Service",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:build}/scripts/debug_runner.py",
        "args": ["app.settings:settings"],
        "cwd": "${workspaceFolder:auth-service}",
        "justMyCode": false,
        "console": "internalConsole",
        "subProcess": false,
        "presentation": { "hidden": false, "group": "services", "order": 3 }
      },
      {
        "name": "➕ Accounts Service",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:build}/scripts/debug_runner.py",
        "args": ["app.settings:settings"],
        "cwd": "${workspaceFolder:account-profile-service}",
        "justMyCode": false,
        "console": "internalConsole",
        "subProcess": false,
        "presentation": { "hidden": false, "group": "services", "order": 2 }
      },
      {
        "name": "🚀 API Gateway",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "node",
        "runtimeArgs": [
          "--inspect-brk",
          "${workspaceFolder:api-gateway}/dist/index.js"
        ],
        "preLaunchTask": "tsc: build",
        "outFiles": ["${workspaceFolder:api-gateway}/dist/**/*.js"],
        "sourceMaps": true,
        "cwd": "${workspaceFolder:api-gateway}",
        "console": "internalConsole",
        "skipFiles": ["<node_internals>/**"],
        "outputCapture": "std",
        "localRoot": "${workspaceFolder:api-gateway}",
        "remoteRoot": "/app",
        "presentation": { "hidden": false, "group": "services", "order": 4 }
      },
      {
        "name": "REACT_DEVTOOLS",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "npx",
        "runtimeArgs": ["react-devtools", "--port", "8097"],
        "cwd": "${workspaceFolder:frontend}",
        "console": "integratedTerminal",
        "presentation": {
          "hidden": true
        }
      },
      {
        "name": "DEBUG_FRONTEND",
        "type": "msedge",
        "request": "attach",
        "port": 9222,
        "url": "https://localhost:3000/*",
        "webRoot": "${workspaceFolder:frontend}",
        "sourceMaps": true,
        "sourceMapPathOverrides": {
          "webpack://_N_E/*": "${webRoot}/*",
          "webpack://*": "${webRoot}/*",
          "/_next/*": "${webRoot}/.next/*",
          "meteor://app/*": "${webRoot}/*"
        },
        "timeout": 30000,
        "trace": true,
        "presentation": { "hidden": true }
      },
      {
        "name": "WebView2",
        "type": "cppvsdbg",
        "request": "launch",
        "program": "${workspaceFolder:webview2-host}/build/Debug/Streamtario.exe",
        "args": [],
        "cwd": "${workspaceFolder:webview2-host}",
        "console": "internalConsole",
        "preLaunchTask": "FRONTEND and webview prepare",
        "environment": [
          {
            "name": "PATH",
            "value": "${workspaceFolder:webview2-host}/deps/libmpv/x86_64;${env:PATH}"
          },
          {
            "name": "WEBVIEW2_ADDITIONAL_BROWSER_ARGUMENTS",
            "value": "--remote-debugging-port=9222 --ignore-certificate-errors"
          }
        ],
        "stopAtEntry": false,
        "logging": {
          "moduleLoad": false,
          "exceptions": false,
          "programOutput": true
        },
        "presentation": { "hidden": true }
      }
    ],
    "compounds": [
      {
        "name": "💯 Services",
        "configurations": [
          "🚀 API Gateway",
          "➕ Addons Service",
          "➕ Accounts Service",
          "➕ Auth Service"
        ],
        "preLaunchTask": "Install Streamtario Python lib",
        "stopAll": true,
        "presentation": { "hidden": false, "group": "compounds", "order": 3 }
      },
      {
        "name": "💯 Frontend",
        "configurations": ["WebView2", "DEBUG_FRONTEND"],
        "presentation": { "hidden": false, "group": "compounds", "order": 2 },
        "stopAll": true
      },
      {
        "name": "💯 All",
        "configurations": [
          "➕ Addons Service",
          "➕ Accounts Service",
          "➕ Auth Service",
          "🚀 API Gateway",
          "WebView2",
          "DEBUG_FRONTEND"
        ],
        "preLaunchTask": "Install Streamtario Python lib",
        "stopAll": true,
        "presentation": { "hidden": false, "group": "compounds", "order": 1 }
      }
    ]
  },
  "settings": {
    "python.analysis.autoImportCompletions": true,
    "python.analysis.extraPaths": ["./packages/python/src"],
    "terminal.integrated.env.windows": {
      "PYTHONPATH": "${workspaceFolder}\\packages\\python\\src"
    },
    "terminal.integrated.env.linux": {
      "PYTHONPATH": "${workspaceFolder}/packages/python/src"
    },
    "terminal.integrated.env.osx": {
      "PYTHONPATH": "${workspaceFolder}/packages/python/src"
    },
    "workbench.editor.enablePreview": false,
    "files.autoSave": "onFocusChange",
    "git.openRepositoryInParentFolders": "always",
    "files.exclude": {
      "**/.git": true,
      "**/node_modules": true,
      "**/.DS_Store": true,
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/.venv": true,
      "**/media": true,
      "**/node_modules/**": true,
      "**/.git/**": true,
      "**/dist/**": true,
      "vcpkg_installed": true,
      "vcpkg": true,
      "**/__init__.py": true
    },
    "editor.formatOnSave": true,
    "cmake.sourceDirectory": "${workspaceFolder:webview2-host}",
    "cmake.useCMakePresets": "auto",
    "cmake.configureOnOpen": true,
    "cmake.buildBeforeRun": true,
    "files.watcherExclude": {
      "**/WEBVIEW_APP/build/**": true,
      "**/WEBVIEW_APP/vcpkg/**": true,
      "**/vcpkg_installed/**": true,
      "**/build/**": true
    },
    "search.exclude": {
      "**/build/**": true,
      "**/vcpkg/**": true,
      "**/vcpkg_installed/**": true
    },
    "C_Cpp.files.exclude": {
      "**/build/**/*": true,
      "**/vcpkg_installed/**": true
    },
    "cmake.configureSettings": {
      "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
      "CMAKE_TOOLCHAIN_FILE": "${workspaceFolder:webview2-host}/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "VCPKG_TARGET_TRIPLET": "x64-windows"
    },
