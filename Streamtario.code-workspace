{
  "folders": [
    {
      "name": "addon-controller-service",
      "path": "apps/addon-controller-service"
    },
    {
      "name": "python-libs",
      "path": "packages/python"
    },
    {
      "name": "scripts",
      "path": "scripts"
    },
    { "name": "frontend", "path": "apps/frontend" },
    {
      "name": "account-profile-service",
      "path": "apps/account-profile-service"
    },
    { "name": "webview2-host", "path": "apps/webview2-host" },
    { "name": "local_dev_deps", "path": "local_dev_deps" },
    { "name": "database", "path": "database" },
    { "name": "dev resources", "path": "dev_resources" },
    { "name": "api-gateway", "path": "apps/api-gateway" },
    { "name": "auth-service", "path": "apps/auth-service" },
    { "name": "torrserver-daemon", "path": "apps/torrserver-daemon" },
    { "name": "Output", "path": "dist" }
  ],
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Build: torrserver-daemon",
        "type": "shell",
        "command": "go build -o ../../../dist/win-x64/streaming-server.exe ./cmd",
        "options": {
          "cwd": "${workspaceFolder:torrserver-daemon}/server"
        },
        "group": "build",
        "presentation": {
          "reveal": "always",
          "panel": "shared",
          "echo": true
        }
      },
      {
        "label": "Build: frontend",
        "type": "shell",
        "command": "npm run build && robocopy .\\out ..\\..\\dist\\win-x64\\www /E /MOVE",
        "options": {
          "cwd": "${workspaceFolder:frontend}"
        },
        "windows": {
          "command": "npm run build && robocopy .\\out ..\\..\\dist\\win-x64\\www /E /MOVE"
        },
        "linux": {
          "command": "npm run build && mkdir -p ../../dist/win-x64/www && mv ./out/* ../../dist/win-x64/www/"
        },
        "osx": {
          "command": "npm run build && mkdir -p ../../dist/win-x64/www && mv ./out/* ../../dist/win-x64/www/"
        },
        "group": "build",
        "presentation": {
          "reveal": "always",
          "panel": "shared",
          "echo": true
        }
      },
      {
        "label": "Build: C++ Host",
        "type": "shell",
        "command": "call \"C:\\Program Files\\Microsoft Visual Studio\\18\\Insiders\\Common7\\Tools\\VsDevCmd.bat\" -arch=amd64 && cmake -S . -B ./build -DCMAKE_BUILD_TYPE=Release -DCMAKE_TOOLCHAIN_FILE=./vcpkg/scripts/buildsystems/vcpkg.cmake -DCMAKE_EXPORT_COMPILE_COMMANDS=ON && cmake --build ./build --config Release && xcopy /Y .\\build\\Streamtario.exe ..\\..\\dist\\win-x64\\",
        "options": {
          "cwd": "${workspaceFolder:webview2-host}",
          "shell": {
            "executable": "cmd.exe",
            "args": ["/d", "/c"]
          }
        },
        "group": "build",
        "problemMatcher": ["$msCompile"],
        "presentation": {
          "reveal": "always",
          "panel": "shared",
          "echo": true
        }
      },
      {
        "label": "tsc: build api-gateway",
        "type": "shell",
        "command": "npm",
        "args": ["run", "build"],
        "options": { "cwd": "${workspaceFolder:api-gateway}" },
        "group": "build",
        "problemMatcher": ["$tsc"],
        "presentation": {
          "reveal": "always",
          "panel": "shared",
          "echo": true
        }
      },
      {
        "label": "Install Streamtario Python lib",
        "type": "shell",
        "command": "${command:python.interpreterPath}",
        "args": [
          "-m",
          "pip",
          "install",
          "-e",
          "../../packages/python",
          "-r",
          "../../requirements.txt"
        ],
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "presentation": {
          "echo": false,
          "reveal": "never",
          "focus": false,
          "panel": "shared",
          "clear": true,
          "close": true
        },
        "problemMatcher": []
      },
      {
        "label": "RUN FRONTEND",
        "type": "shell",
        "command": "npm run dev",
        "options": { "cwd": "${workspaceFolder:frontend}" },
        "isBackground": true,
        "problemMatcher": {
          "pattern": {
            "regexp": ".*Ready in.*",
            "file": 1,
            "location": 2,
            "message": 3
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".*Next.js.*",
            "endsPattern": ".*Ready in.*"
          }
        }
      },
      {
        "label": "CMake: Configure & Build",
        "type": "shell",
        "command": "call \"C:\\Program Files\\Microsoft Visual Studio\\18\\Insiders\\Common7\\Tools\\VsDevCmd.bat\" -arch=amd64 && cmake -S ${workspaceFolder:webview2-host} -B ${workspaceFolder:webview2-host}/build -DCMAKE_BUILD_TYPE=Debug -DCMAKE_TOOLCHAIN_FILE=${workspaceFolder:webview2-host}/vcpkg/scripts/buildsystems/vcpkg.cmake -DCMAKE_EXPORT_COMPILE_COMMANDS=ON && cmake --build ${workspaceFolder:webview2-host}/build --config Debug",
        "options": {
          "shell": {
            "executable": "cmd.exe",
            "args": ["/d", "/c"]
          }
        },
        "group": { "kind": "build", "isDefault": true },
        "problemMatcher": ["$msCompile"]
      },
      {
        "label": "FRONTEND and webview prepare",
        "dependsOrder": "sequence",
        "dependsOn": ["CMake: Configure & Build", "RUN FRONTEND"]
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "inputs": [
      {
        "id": "migrationMessage",
        "type": "promptString",
        "description": "Enter the message for the new migration",
        "default": "New migration"
      }
    ],
    "configurations": [
      {
        "name": "Build: Go Daemon",
        "type": "cppvsdbg",
        "request": "launch",
        "program": "cmd.exe",
        "cwd": "${workspaceFolder:torrserver-daemon}",
        "args": ["/C", "echo Build finished."],
        "preLaunchTask": "Build: torrserver-daemon",
        "console": "integratedTerminal",
        "presentation": { "hidden": false, "group": "Build Tasks", "order": 1 }
      },
      {
        "name": "Build: Frontend",
        "type": "cppvsdbg",
        "request": "launch",
        "cwd": "${workspaceFolder:frontend}",
        "program": "cmd.exe",
        "args": ["/C", "echo Build finished."],
        "preLaunchTask": "Build: frontend",
        "console": "integratedTerminal",
        "presentation": { "hidden": false, "group": "Build Tasks", "order": 3 }
      },
      {
        "name": "Build: C++ Host",
        "type": "cppvsdbg",
        "cwd": "${workspaceRoot}",
        "request": "launch",
        "program": "cmd.exe",
        "args": ["/C", "echo Build finished."],
        "preLaunchTask": "Build: C++ Host",
        "console": "integratedTerminal",
        "presentation": { "hidden": false, "group": "Build Tasks", "order": 4 }
      },
      {
        "name": "Purge & Rebuild All (Docker Compose)",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "docker-compose down --volumes --remove-orphans; docker rmi -f streamtario-account-profile-service:latest streamtario-addon-controller-service:latest streamtario-api-gateway:latest streamtario-auth-service:latest 2>$null; docker builder prune -af; docker system prune -af; docker-compose build --no-cache; docker-compose up -d"
        ],
        "console": "integratedTerminal",
        "presentation": { "hidden": false, "group": "Docker", "order": 1 }
      },
      {
        "name": "Rebuild & Run: api-gateway",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "docker-compose build --no-cache api-gateway; docker-compose up -d api-gateway"
        ],
        "console": "integratedTerminal",
        "presentation": { "hidden": false, "group": "Docker", "order": 1 }
      },
      {
        "name": "Rebuild & Run: addon-controller-service",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "docker-compose build --no-cache addon-controller-service; docker-compose up -d addon-controller-service"
        ],
        "console": "integratedTerminal",
        "presentation": { "hidden": false, "group": "Docker", "order": 1 }
      },
      {
        "name": "Rebuild & Run: account-profile-service",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "docker-compose build --no-cache account-profile-service; docker-compose up -d account-profile-service"
        ],
        "console": "integratedTerminal",
        "presentation": { "hidden": false, "group": "Docker", "order": 1 }
      },
      {
        "name": "Rebuild & Run: auth-service",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "docker-compose build --no-cache auth-service; docker-compose up -d auth-service"
        ],
        "console": "integratedTerminal",
        "presentation": { "hidden": false, "group": "Docker", "order": 1 }
      },
      {
        "name": "Follow Logs (docker-compose)",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "docker-compose logs --tail=200 --follow"
        ],
        "console": "integratedTerminal",
        "presentation": { "hidden": false, "group": "Docker", "order": 1 },
        "internalConsoleOptions": "neverOpen"
      },
      {
        "name": "📅 Create Database",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:scripts}/db_cli.py",
        "args": ["create"],
        "console": "integratedTerminal",
        "presentation": { "hidden": false, "group": "db", "order": 1 }
      },
      {
        "name": "📅 Create Database Docker",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "docker-compose run --rm scripts python scripts/db_cli_Docker.py create"
        ],
        "console": "integratedTerminal",
        "presentation": { "hidden": false, "group": "Docker-DB", "order": 1 }
      },
      {
        "name": "📅 Apply Migrations",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:scripts}/db_cli.py",
        "args": ["upgrade", "head"],
        "console": "integratedTerminal",
        "presentation": { "hidden": false, "group": "db", "order": 1 }
      },
      {
        "name": "📅 Apply Migrations Docker",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "docker-compose run --rm scripts python scripts/db_cli_Docker.py upgrade head"
        ],
        "console": "integratedTerminal",
        "presentation": { "hidden": false, "group": "Docker-DB", "order": 1 }
      },
      {
        "name": "📅 Generate New Migration",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:scripts}/db_cli.py",
        "args": ["generate", "-m", "${input:migrationMessage}"],
        "console": "integratedTerminal",
        "presentation": { "hidden": false, "group": "db", "order": 2 }
      },
      {
        "name": "⚠️ Drop Database",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:scripts}/db_cli.py",
        "args": ["drop"],
        "console": "integratedTerminal",
        "presentation": { "hidden": false, "group": "db", "order": 3 }
      },
      {
        "name": "⚠️ Drop Database Docker",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "docker-compose run --rm scripts python scripts/db_cli_Docker.py drop"
        ],
        "console": "integratedTerminal",
        "presentation": { "hidden": false, "group": "Docker-DB", "order": 3 }
      },
      {
        "name": "➕ Addons Service",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:scripts}/debug_runner.py",
        "args": ["app.settings:settings"],
        "cwd": "${workspaceFolder:addon-controller-service}",
        "justMyCode": false,
        "console": "internalConsole",
        "subProcess": false,
        "presentation": { "hidden": false, "group": "services", "order": 3 }
      },
      {
        "name": "➕ Auth Service",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:scripts}/debug_runner.py",
        "args": ["app.settings:settings"],
        "cwd": "${workspaceFolder:auth-service}",
        "justMyCode": false,
        "console": "internalConsole",
        "subProcess": false,
        "presentation": { "hidden": false, "group": "services", "order": 3 }
      },
      {
        "name": "➕ Accounts Service",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:scripts}/debug_runner.py",
        "args": ["app.settings:settings"],
        "cwd": "${workspaceFolder:account-profile-service}",
        "justMyCode": false,
        "console": "internalConsole",
        "subProcess": false,
        "presentation": { "hidden": false, "group": "services", "order": 2 }
      },
      {
        "name": "➕ torrserver-daemon",
        "type": "go",
        "request": "launch",
        "mode": "auto",
        "program": "${workspaceFolder:torrserver-daemon}/server/cmd",
        "presentation": { "hidden": false, "group": "services", "order": 5 }
      },
      {
        "name": "🚀 API Gateway",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "node",
        "stopOnEntry": false,
        "runtimeArgs": ["--inspect"],
        "env": { "DOTENV_CONFIG_PATH": "../../.env" },
        "program": "${workspaceFolder:api-gateway}/dist/index.js",
        "preLaunchTask": "tsc: build api-gateway",
        "outFiles": ["${workspaceFolder:api-gateway}/dist/**/*.js"],
        "cwd": "${workspaceFolder:api-gateway}",
        "console": "internalConsole",
        "skipFiles": [
          "<node_internals>/**",
          "**/node_modules/**",
          "${workspaceFolder:api-gateway}/dist/index.js"
        ],
        "outputCapture": "std",
        "localRoot": "${workspaceFolder:api-gateway}",
        "remoteRoot": "/app",
        "presentation": { "hidden": false, "group": "services", "order": 6 }
      },
      {
        "name": "REACT_DEVTOOLS",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "npx",
        "runtimeArgs": ["react-devtools", "--port", "8097"],
        "cwd": "${workspaceFolder:frontend}",
        "console": "integratedTerminal"
      },
      {
        "name": "DEBUG_FRONTEND",
        "type": "msedge",
        "request": "attach",
        "port": 9222,
        "url": "https://localhost:3000/*",
        "webRoot": "${workspaceFolder:frontend}",
        "sourceMaps": true,
        "sourceMapPathOverrides": {
          "webpack://_N_E/*": "${webRoot}/*",
          "webpack://*": "${webRoot}/*",
          "/_next/*": "${webRoot}/.next/*",
          "meteor://app/*": "${webRoot}/*"
        },
        "timeout": 30000,
        "trace": true,
        "presentation": { "hidden": false }
      },
      {
        "name": "WebView2",
        "type": "cppvsdbg",
        "request": "launch",
        "program": "${workspaceFolder:webview2-host}/build/Streamtario.exe",
        "args": [],
        "cwd": "${workspaceFolder:webview2-host}",
        "console": "internalConsole",
        "preLaunchTask": "FRONTEND and webview prepare",
        "environment": [
          {
            "name": "PATH",
            "value": "${workspaceFolder:webview2-host}/deps/libmpv/x86_64;${env:PATH}"
          },
          {
            "name": "WEBVIEW2_ADDITIONAL_BROWSER_ARGUMENTS",
            "value": "--remote-debugging-port=9222 --ignore-certificate-errors"
          }
        ],
        "stopAtEntry": false,
        "logging": {
          "moduleLoad": false,
          "exceptions": false,
          "programOutput": true
        },
        "presentation": { "hidden": true }
      }
    ],
    "compounds": [
      {
        "name": "💯 Services",
        "configurations": [
          "➕ Addons Service",
          "➕ Accounts Service",
          "➕ Auth Service",
          // "➕ torrserver-daemon",
          "🚀 API Gateway"
        ],
        "preLaunchTask": "Install Streamtario Python lib",
        "stopAll": false,
        "presentation": { "hidden": false, "group": "compounds", "order": 3 }
      },
      {
        "name": "💯 Frontend",
        "configurations": ["WebView2", "DEBUG_FRONTEND"],
        "presentation": { "hidden": false, "group": "compounds", "order": 2 },
        "stopAll": false
      },
      {
        "name": "💯 All",
        "configurations": [
          "➕ Addons Service",
          "➕ Accounts Service",
          "➕ Auth Service",
          "➕ torrserver-daemon",
          "🚀 API Gateway",
          "WebView2",
          "DEBUG_FRONTEND",
          "REACT_DEVTOOLS"
        ],
        "preLaunchTask": "Install Streamtario Python lib",
        "stopAll": true,
        "presentation": { "hidden": false, "group": "compounds", "order": 1 }
      }
    ]
  },
  "settings": {
    "python.analysis.autoImportCompletions": true,
    "python.analysis.extraPaths": ["./packages/python/src"],
    "terminal.integrated.env.linux": {
      "PYTHONPATH": "${workspaceFolder}/packages/python/src"
    },
    "terminal.integrated.env.osx": {
      "PYTHONPATH": "${workspaceFolder}/packages/python/src"
    },
    "workbench.editor.enablePreview": false,
    "files.autoSave": "onFocusChange",
    "git.openRepositoryInParentFolders": "always",
    "files.exclude": {
      "**/.git": true,
      "**/node_modules": true,
      "**/.DS_Store": true,
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/.venv": true,
      "**/media": true,
      "**/node_modules/**": true,
      "**/.git/**": true,
      "**/dist/**": true,
      "vcpkg_installed": true,
      "vcpkg": true,
      "**/__init__.py": true
    },
    "editor.formatOnSave": true,
    "cmake.sourceDirectory": "${workspaceFolder:webview2-host}",
    "cmake.useCMakePresets": "auto",
    "cmake.configureOnOpen": true,
    "cmake.buildBeforeRun": true,
    "files.watcherExclude": {
      "**/WEBVIEW_APP/build/**": true,
      "**/WEBVIEW_APP/vcpkg/**": true,
      "**/vcpkg_installed/**": true,
      "**/build/**": true,
      "**/pkg/mod/**": true
    },
    "search.exclude": {
      "**/build/**": true,
      "**/vcpkg/**": true,
      "**/vcpkg_installed/**": true,
      "**/pkg/mod": true
    },
    "C_Cpp.files.exclude": {
      "**/build/**/*": true,
      "**/vcpkg_installed/**": true,
      "**/pkg/mod": true
    },
    "cmake.configureSettings": {
      "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
      "CMAKE_TOOLCHAIN_FILE": "${workspaceFolder:webview2-host}/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "VCPKG_TARGET_TRIPLET": "x64-windows"
    },
    "terminal.integrated.env.windows": {
      "VCPKG_VISUAL_STUDIO_PATH": "C:\\Program Files\\Microsoft Visual Studio\\18\\Insiders"
    },
