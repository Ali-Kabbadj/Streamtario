{
  "folders": [
    {
      "name": "addon-controller-service",
      "path": "apps/addon-controller-service"
    },
    {
      "name": "python-libs",
      "path": "packages/python"
    },
    { "name": "typescript-lib", "path": "packages/typescript" },
    { "name": "api-gateway", "path": "apps/api-gateway" },
    { "name": "auth-service", "path": "apps/auth-service" },
    { "name": "frontend", "path": "apps/frontend" },
    { "name": "state-tracker-service", "path": "apps/state-tracker-service" },
    {
      "name": "account-profile-service",
      "path": "apps/account-profile-service"
    },
    { "name": "webview2-host", "path": "apps/webview2-host" },
    { "name": "build", "path": "build" },
    { "name": "local_dev_deps", "path": "local_dev_deps" },
    { "name": "database", "path": "database" }
  ],
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Install Streamtario Python lib",
        "type": "shell",
        "command": "${command:python.interpreterPath}",
        "args": [
          "-m",
          "pip",
          "install",
          "-e",
          "../../packages/python",
          "-r",
          "../../requirements.txt"
        ],
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "presentation": {
          "echo": false,
          "reveal": "never",
          "focus": false,
          "panel": "shared",
          "clear": true,
          "close": true
        },
        "problemMatcher": []
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "inputs": [
      {
        "id": "migrationMessage",
        "type": "promptString",
        "description": "Enter the message for the new migration",
        "default": "New migration"
      }
    ],
    "configurations": [
      {
        "name": "📅 Create Database",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:build}/scripts/db_cli.py",
        "args": ["create"],
        "console": "integratedTerminal",
        "presentation": {
          "hidden": false,
          "group": "db",
          "order": 1
        }
      },
      {
        "name": "📅 Apply Migrations",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:build}/scripts/db_cli.py",
        "args": ["upgrade", "head"],
        "console": "integratedTerminal",
        "presentation": {
          "hidden": false,
          "group": "db",
          "order": 1
        }
      },
      {
        "name": "📅 Generate New Migration",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:build}/scripts/db_cli.py",
        "args": ["generate", "-m", "${input:migrationMessage}"],
        "console": "integratedTerminal",
        "presentation": {
          "hidden": false,
          "group": "db",
          "order": 2
        }
      },
      {
        "name": "⚠️ Drop Database",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:build}/scripts/db_cli.py",
        "args": ["drop"],
        "console": "integratedTerminal",
        "presentation": {
          "hidden": false,
          "group": "db",
          "order": 3
        }
      },
      {
        "name": "➕ Addons Service",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:build}/scripts/debug_runner.py",
        "args": ["app.settings:settings"],
        "cwd": "${workspaceFolder:addon-controller-service}",
        "justMyCode": false,
        // "preLaunchTask": "Install Streamtario Python lib",
        "console": "internalConsole",
        "subProcess": false,
        "presentation": {
          "hidden": false,
          "group": "services",
          "order": 3
        }
      },
      {
        "name": "➕ Accounts Service",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:build}/scripts/debug_runner.py",
        "args": ["app.settings:settings"],
        "cwd": "${workspaceFolder:account-profile-service}",
        "justMyCode": false,
        // "preLaunchTask": "Install Streamtario Python lib",
        "console": "internalConsole",
        "subProcess": false,
        "presentation": {
          "hidden": false,
          "group": "services",
          "order": 2
        }
      }
    ],
    "compounds": [
      {
        "name": "💯 All Services",
        "configurations": ["➕ Addons Service", "➕ Accounts Service"],
        "preLaunchTask": "Install Streamtario Python lib",
        "presentation": {
          "hidden": false,
          "group": "services",
          "order": 1
        }
      }
    ]
  },

  "settings": {
    "python.analysis.autoImportCompletions": true,
    "python.analysis.extraPaths": ["./packages/python/src"],
    "terminal.integrated.env.windows": {
      "PYTHONPATH": "${workspaceFolder}\\packages\\python\\src"
    },
    "terminal.integrated.env.linux": {
      "PYTHONPATH": "${workspaceFolder}/packages/python/src"
    },
    "terminal.integrated.env.osx": {
      "PYTHONPATH": "${workspaceFolder}/packages/python/src"
    },
    "workbench.editor.enablePreview": false,
    "files.autoSave": "onFocusChange",
    "git.openRepositoryInParentFolders": "always",
    "files.exclude": {
      "**/.git": true,
      "**/node_modules": true,
      "**/.DS_Store": true,
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/.venv": true,
      "**/media": true,
      "**/node_modules/**": true,
      "**/.git/**": true,
      "**/dist/**": true,
      "vcpkg_installed": true,
      "vcpkg": true,
      "**/__init__.py": true
    },
    "editor.formatOnSave": true
  }
}
