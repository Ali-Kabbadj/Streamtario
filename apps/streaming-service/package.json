{
  "name": "streaming-server",
  "version": "1.0.0",
  "description": "WebTorrent streaming server",
  "type": "module",
  "main": "dist/server.js",
  "files": [
    "dist/"
  ],
  "scripts": {
   "clean": "node -e \"const fs = require('fs'); const p = 'dist'; if (fs.existsSync(p)) { try { fs.rmSync(p, { recursive: true, force: true }); console.log('🧹 Deleted', p); } catch (e) { console.warn('Could not delete', p, e); } }\"",
    "build": "npm run clean && tsc",
    "start": "node dist/app.js",
    "dev": "nodemon",
    "prepack": "npm run build"
  },
  "dependencies": {
    "bencode": "4.0.0",
    "colors": "^1.4.0",
    "cors": "2.8.5",
    "express": "^5.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "https": "^1.0.0",
    "pdfjs-dist": "^5.3.93",
    "sanitize-filename": "^1.6.3",
    "ts-node": "^10.9.2",
    "unzipper": "^0.12.3",
    "webtorrent": "2.6.10",
    "winston": "^3.17.0",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/bencode": "2.0.4",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/node": "24.0.12",
    "@types/parse-torrent": "^5.8.7",
    "@types/webtorrent": "0.110.0",
    "@types/ws": "8.18.1",
    "nodemon": "3.1.10",
    "typescript": "5.8.3"
  }
}
