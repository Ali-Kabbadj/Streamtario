{
  "name": "streaming-server",
  "version": "1.0.0",
  "description": "WebTorrent streaming server",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist/"
  ],
  "scripts": {
    "clean": "node -e \"const fs = require('fs'); const p = 'dist'; if (fs.existsSync(p)) { try { fs.rmSync(p, { recursive: true, force: true }); console.log('🧹 Deleted', p); } catch (e) { console.warn('Could not delete', p, e); } }\"",
    "build": "npm run clean && tsc",
    "start": "node dist/app.js",
    "dev": "nodemon",
    "prepack": "npm run build"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "cors": "2.8.5",
    "express": "^5.1.0",
    "http-proxy-middleware": "3.0.5",
    "https": "^1.0.0",
    "ts-node": "^10.9.2",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/node": "24.1.0",
    "@types/ws": "8.18.1",
    "nodemon": "3.1.10",
    "typescript": "^5.9.2"
  }
}
