# Application Environment
APP_ENV=development

# PostgreSQL Connection
DB_USER=postgres
DB_PASSWORD=3248
DB_HOST=localhost
DB_PORT=5432
DB_NAME=streamtario

# Redis Connection
REDIS_HOST=localhost
REDIS_PORT=6379

# Service-to-Service URLs
ADDON_CONTROLLER_URL=https://localhost:8001
ACCOUNT_PROFILE_SERVICE=https://localhost:8002

# Allowd Origins
ALLOWED_ORIGINS=https://localhost:3000,http://localhost:3000,https://localhost:8002,https://localhost:8001,http://localhost:8002,http://localhost:8001

# SSL
SSL_KEYFILE = "../../local_dev_deps/certs/localhost+2-key.pem"
SSL_CERTFILE ="../../local_dev_deps/certs/localhost+2.pem"